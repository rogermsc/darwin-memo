    {
      "question": "Are LLM benchmark arms safe to run in CI?",
      "answer": "No. Sampled model output is not deterministic; LLM suites must never run in CI and stay opt-in (bench --suite llm).",
      "kind": "explicit",
      "sources": [
        "docs/benchmarks"
      ],
      "energy": 0.6999999999999997,
      "born_cycle": 0,
      "recorded_ts": "2026-08-20T00:02:31+00:00",
      "last_used_cycle": -1,
      "uses": 0,
      "lineage": [],
      "id": "fda3317d2104"
    },
    {
      "question": "Can retrieval scoring read entry energy?",
      "answer": "Never. Retrieval scores are pure relevance and energy is only a sort tie-break in the store; selection pressure must come from outcomes, not from retrieval preferring incumbents.",
      "kind": "explicit",
      "sources": [
        "docs/paper-to-code"
      ],
      "energy": 0.6999999999999997,
      "born_cycle": 0,
      "recorded_ts": "2026-08-20T00:02:31+00:00",
