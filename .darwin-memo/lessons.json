    {
      "question": "Can retrieval scoring read entry energy?",
      "answer": "Never. Retrieval scores are pure relevance and energy is only a sort tie-break in the store; selection pressure must come from outcomes, not from retrieval preferring incumbents.",
      "kind": "explicit",
      "sources": [
        "docs/paper-to-code"
      ],
      "energy": -1.667720128661898e-11,
