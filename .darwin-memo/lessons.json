    },
    {
      "question": "Do new environments need extra decision_polarity markers?",
      "answer": "Yes. The built-in vocabulary covers delete/remove and apply/keep only; a new action verb needs extra_positive and extra_negative markers or every answer reads as silence and the population starves at about spawn energy over upkeep cycles.",
      "kind": "explicit",
      "sources": [
        "readme-environments"
      ],
      "energy": 0.24999999999999967,
      "born_cycle": 0,
      "recorded_ts": "",
      "last_used_cycle": 15,
      "uses": 1,
      "lineage": [],
      "id": "3b61822cf5a6"
    },
    {
      "question": "Are StorageEnv seeds independent samples?",
      "answer": "No. StorageEnv derives cycle worlds from seed plus cycle, so adjacent seeds are shifted windows of one another; treat across-seed spreads as smoother than independent draws.",
      "kind": "explicit",
      "sources": [
        "noisy-suite-review"
      ],
      "energy": 0.09999999999999969,
      "born_cycle": 0,
      "recorded_ts": "",
      "last_used_cycle": -1,
