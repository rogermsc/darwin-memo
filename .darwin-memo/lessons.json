      "id": "23b08af0d95b"
    },
    {
      "question": "Is it safe to add new required metric keys that only some suites emit?",
      "answer": "No. Emit new metrics unconditionally with zero or equal defaults across every suite, then add them to the required keys, or report --check breaks CI on the other suites.",
      "kind": "explicit",
      "sources": [
        "noisy-suite-review"
      ],
      "energy": 1.8919685788908578,
      "born_cycle": 0,
      "recorded_ts": "2026-08-20T00:02:31+00:00",
      "last_used_cycle": 5,
