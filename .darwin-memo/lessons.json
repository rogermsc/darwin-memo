    {
      "question": "Are LLM benchmark arms safe to run in CI?",
      "answer": "No. Sampled model output is not deterministic; LLM suites must never run in CI and stay opt-in (bench --suite llm).",
      "kind": "explicit",
      "sources": [
        "docs/benchmarks"
      ],
      "energy": 0.6999996329173268,
      "born_cycle": 0,
      "recorded_ts": "",
