    },
    {
      "question": "Should bench result JSON files be committed?",
      "answer": "No. bench/results is regenerated, not committed; doc tables are regenerated from the Reproduce commands, and if numbers disagree the generated doc wins.",
      "kind": "explicit",
      "sources": [
        "docs/benchmarks"
