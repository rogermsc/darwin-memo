      "id": "5ee2277c20ba"
    },
    {
      "question": "Do new environments need extra decision_polarity markers?",
      "answer": "Yes. The built-in vocabulary covers delete/remove and apply/keep only; a new action verb needs extra_positive and extra_negative markers or every answer reads as silence and the population starves at about spawn energy over upkeep cycles.",
      "kind": "explicit",
      "sources": [
        "readme-environments"
      ],
      "energy": -3.191891195797325e-16,
      "born_cycle": 0,
