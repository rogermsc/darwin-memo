      "id": "5dfb38d4c662"
    },
    {
      "question": "Does the poison-kill CI gate apply to noisy benchmark runs?",
      "answer": "No. The kill gate is a noiseless-era invariant and noisy runs are exempt: a delayed or missed kill under measurement noise is an honest expected result, not a CI failure.",
      "kind": "explicit",
      "sources": [
        "noisy-suite-review"
      ],
      "energy": 0.6999999999999997,
      "born_cycle": 0,
      "recorded_ts": "2026-08-20T00:02:31+00:00",
