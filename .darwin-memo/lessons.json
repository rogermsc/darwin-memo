    {
      "question": "Are StorageEnv seeds independent samples?",
      "answer": "No. StorageEnv derives cycle worlds from seed plus cycle, so adjacent seeds are shifted windows of one another; treat across-seed spreads as smoother than independent draws.",
      "kind": "explicit",
      "sources": [
        "noisy-suite-review"
      ],
      "energy": -3.191891195797325e-16,
      "born_cycle": 0,
      "recorded_ts": "",
      "last_used_cycle": -1,
      "uses": 0,
      "lineage": [],
      "id": "8388150e56d3"
    },
    {
      "question": "Does the poison-kill CI gate apply to noisy benchmark runs?",
      "answer": "No. The kill gate is a noiseless-era invariant and noisy runs are exempt: a delayed or missed kill under measurement noise is an honest expected result, not a CI failure.",
      "kind": "explicit",
      "sources": [
        "noisy-suite-review"
      ],
      "energy": -9.177066849497262e-08,
      "born_cycle": 0,
      "recorded_ts": "",
